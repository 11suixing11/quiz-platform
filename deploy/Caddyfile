(tls_compat) {
	tls {
		curves x25519 secp256r1
	}
}

(security_headers) {
	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
	}
}

(public_media) {
	@public_media path_regexp ^/media/public/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+/(320|960|1600)\.webp$
	handle @public_media {
		uri strip_prefix /media/public
		root * /var/lib/quiz-platform/media/public
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}

# The Next.js standalone server owns both rendered pages and /api routes.
# Caddy remains the public TLS endpoint and reverse proxy.
# Canonical production host.
knowyourself.cc.cd {
	import tls_compat
	encode gzip
	import security_headers

	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Keep the origin health probe independent of application state.
	handle /healthz {
		respond "ok" 200
	}

	import public_media

	handle {
		reverse_proxy 127.0.0.1:3333 {
			header_up X-Real-IP {remote_host}
			header_up -CF-Connecting-IP
		}
	}
}

# Legacy hosts permanently redirect to the canonical domain.
loveyourself.cc.cd, www.loveyourself.cc.cd, loveuu.xyz, www.loveuu.xyz {
	import tls_compat
	import security_headers
	redir https://knowyourself.cc.cd{uri} 301
}

www.knowyourself.cc.cd {
	import tls_compat
	import security_headers
	redir https://knowyourself.cc.cd{uri} 301
}

# A no-index origin probe used by deployment checks.
beta.loveuu.xyz {
	import tls_compat
	encode gzip
	import security_headers
	header X-Robots-Tag "noindex, nofollow"

	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	handle /healthz {
		respond "ok" 200
	}

	import public_media

	handle {
		reverse_proxy 127.0.0.1:3333 {
			header_up X-Real-IP {remote_host}
			header_up -CF-Connecting-IP
		}
	}
}

# A DNS-only maintenance hostname used for origin smoke tests. It is never
# indexed and intentionally does not redirect, so deploy checks can bypass
# public DNS propagation while retaining the production host configuration.
quiz.107-151-246-167.sslip.io {
	import tls_compat
	encode gzip
	import security_headers
	header X-Robots-Tag "noindex, nofollow"

	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	handle /healthz {
		respond "ok" 200
	}

	import public_media

	handle {
		reverse_proxy 127.0.0.1:3333 {
			header_up X-Real-IP {remote_host}
			header_up -CF-Connecting-IP
		}
	}
}
